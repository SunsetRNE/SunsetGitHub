{
  "scopeName": "text.html.markdown",
  "name": "Markdown",
  "patterns": [
    { "include": "#heading" },
    { "include": "#fenced_code" },
    { "include": "#blockquote" },
    { "include": "#list" },
    { "include": "#emphasis" },
    { "include": "#link" },
    { "include": "#inline_code" },
    { "include": "#thematic_break" }
  ],
  "repository": {
    "heading": {
      "match": "^(#{1,6})\\s+(.+)$",
      "name": "markup.heading.markdown",
      "captures": {
        "1": { "name": "punctuation.definition.heading.markdown" },
        "2": { "name": "entity.name.section.markdown" }
      }
    },
    "fenced_code": {
      "begin": "^(```+)(.*)$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.fenced_code_block.begin.markdown" },
        "2": { "name": "entity.name.function.markdown" }
      },
      "end": "^(```+)\\s*$",
      "endCaptures": {
        "1": { "name": "punctuation.definition.fenced_code_block.end.markdown" }
      },
      "name": "markup.fenced_code.block.markdown"
    },
    "blockquote": {
      "match": "^>\\s?.*$",
      "name": "markup.quote.markdown"
    },
    "list": {
      "match": "^\\s*([*-]|[0-9]+\\.)\\s+.*$",
      "name": "markup.list.markdown"
    },
    "emphasis": {
      "patterns": [
        {
          "match": "(?<!\\\\)(\\*\\*|__)(?=\\S)(.+?)(?<=\\S)\\1",
          "name": "markup.bold.markdown"
        },
        {
          "match": "(?<!\\\\)(\\*|_)(?=\\S)(.+?)(?<=\\S)\\1",
          "name": "markup.italic.markdown"
        }
      ]
    },
    "link": {
      "match": "!?(\\[)([^\\]]+)(\\])\\(([^)]+)\\)",
      "name": "markup.link.markdown",
      "captures": {
        "1": { "name": "punctuation.definition.link.markdown" },
        "2": { "name": "string.other.link.title.markdown" },
        "3": { "name": "punctuation.definition.link.markdown" },
        "4": { "name": "string.other.link.destination.markdown" }
      }
    },
    "inline_code": {
      "match": "`[^`]+`",
      "name": "markup.inline.raw.markdown"
    },
    "thematic_break": {
      "match": "^([*-])\\s*\\1\\s*\\1\\s*$",
      "name": "punctuation.definition.thematic.break.markdown"
    }
  }
}