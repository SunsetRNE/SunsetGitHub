{
  "scopeName": "source.json",
  "name": "JSON",
  "patterns": [
    { "include": "#value" }
  ],
  "repository": {
    "value": {
      "patterns": [
        { "include": "#object" },
        { "include": "#array" },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#constants" }
      ]
    },
    "object": {
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.dictionary.begin.json" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.dictionary.end.json" }
      },
      "patterns": [
        { "include": "#pair" },
        { "include": "#value" },
        { "match": ":", "name": "punctuation.separator.dictionary.key-value.json" },
        { "match": ",", "name": "punctuation.separator.dictionary.pair.json" }
      ]
    },
    "array": {
      "begin": "\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.array.begin.json" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.array.end.json" }
      },
      "patterns": [
        { "include": "#value" },
        { "match": ",", "name": "punctuation.separator.array.json" }
      ]
    },
    "pair": {
      "begin": "(\")",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.string.begin.json" }
      },
      "end": "(\")\\s*(?=:)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.json" }
      },
      "name": "string.quoted.double.json entity.name.tag.json",
      "patterns": [
        { "include": "#escape" }
      ]
    },
    "string": {
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.json" }
      },
      "end": "\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.json" }
      },
      "name": "string.quoted.double.json",
      "patterns": [
        { "include": "#escape" }
      ]
    },
    "escape": {
      "match": "\\\\(?:[\\\"/bfnrt]|u[0-9a-fA-F]{4})",
      "name": "constant.character.escape.json"
    },
    "number": {
      "match": "-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?",
      "name": "constant.numeric.json"
    },
    "constants": {
      "match": "\\b(?:true|false|null)\\b",
      "name": "constant.language.json"
    }
  }
}
