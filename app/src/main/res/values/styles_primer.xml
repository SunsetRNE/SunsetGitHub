<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GitHub Primer Base Styles for Components -->
    
    <!-- Cards -->
    <style name="Widget.SunsetGitHub.Primer.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/github_primer_canvas_overlay</item>
        <item name="cardCornerRadius">6dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/github_primer_border_default</item>
    </style>
    
    <style name="Widget.SunsetGitHub.Primer.Card.Subtle" parent="Widget.SunsetGitHub.Primer.Card">
        <item name="cardBackgroundColor">@color/github_primer_canvas_subtle</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.SunsetGitHub.Primer.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/github_primer_button_bg</item>
        <item name="android:textColor">@color/github_primer_fg_default</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/github_primer_button_border</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.SunsetGitHub.Primer.Body.Medium</item>
    </style>

    <style name="Widget.SunsetGitHub.Primer.Button.Primary" parent="Widget.SunsetGitHub.Primer.Button">
        <item name="backgroundTint">@color/github_primer_button_primary_bg</item>
        <item name="android:textColor">@color/github_primer_fg_onEmphasis</item>
        <item name="strokeWidth">0dp</item>
    </style>
    
    <style name="Widget.SunsetGitHub.Primer.Button.Danger" parent="Widget.SunsetGitHub.Primer.Button">
        <item name="android:textColor">@color/github_primer_danger_fg</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.SunsetGitHub.Primer.Heading1" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/github_primer_fg_default</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
    </style>
    
    <style name="TextAppearance.SunsetGitHub.Primer.Heading2" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/github_primer_fg_default</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>
    
    <style name="TextAppearance.SunsetGitHub.Primer.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/github_primer_fg_default</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.SunsetGitHub.Primer.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/github_primer_fg_default</item>
        <item name="android:textSize">14sp</item>
    </style>
    
    <style name="TextAppearance.SunsetGitHub.Primer.Body.Medium" parent="TextAppearance.SunsetGitHub.Primer.Body">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SunsetGitHub.Primer.Body.Muted" parent="TextAppearance.SunsetGitHub.Primer.Body">
        <item name="android:textColor">@color/github_primer_fg_muted</item>
    </style>
    
    <style name="TextAppearance.SunsetGitHub.Primer.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/github_primer_fg_muted</item>
        <item name="android:textSize">12sp</item>
    </style>
    
    <!-- Meta Badges (Labels, Languages, Status) -->
    <style name="Widget.SunsetGitHub.Primer.Badge" parent="Widget.MaterialComponents.TextView">
        <item name="android:background">@drawable/bg_primer_badge</item>
        <item name="android:textColor">@color/github_primer_fg_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>