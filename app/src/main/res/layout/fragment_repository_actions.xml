<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_canvas"
    tools:context=".ui.repo.RepositoryActionsFragment">

    <ScrollView
        android:id="@+id/scroll_repository_actions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/page_vertical_padding">

            <TextView
                android:id="@+id/text_repository_actions_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="正在加载 Actions……" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/github_surface"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <HorizontalScrollView
                    android:id="@+id/scroll_repository_actions_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/container_repository_actions_filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp" />
                </HorizontalScrollView>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_repository_actions_retry"
                style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/repository_actions_retry"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/container_repository_actions_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/github_surface"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/container_repository_actions_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:showDividers="none" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_repository_actions_load_more"
                    style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/repository_actions_load_more"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_repository_actions_unavailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_repository_empty_state_panel"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/text_repository_actions_unavailable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                    android:textColor="@color/github_text_secondary"
                    tools:text="该仓库可能未启用 Actions，或当前账号无法访问 Actions 分区。" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_repository_actions_open_in_github"
                    style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/repository_actions_open_in_github" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_repository_actions_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_repository_empty_state_panel"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/text_repository_actions_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/repository_actions_empty"
                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                    android:textColor="@color/github_text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>