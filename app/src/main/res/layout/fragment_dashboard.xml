<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_canvas"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/page_horizontal_padding"
    android:paddingTop="@dimen/page_vertical_padding"
    android:paddingBottom="0dp"
    tools:context=".ui.dashboard.DashboardFragment">

    <!-- 搜索 + 排序：精致内联工具行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/container_repository_search"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_github_search_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/dashboard_search_icon_content_description"
                android:src="@drawable/ic_search_24" />

            <EditText
                android:id="@+id/edit_repository_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/dashboard_search_hint"
                android:inputType="text"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/github_text_primary"
                android:textColorHint="@color/github_text_muted"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/button_clear_repository_search"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/dashboard_clear_search_content_description"
                android:padding="6dp"
                android:src="@drawable/ic_close_24"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_repository_sort"
            style="@style/Widget.SunsetGitHub.Material.GlobalButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/dashboard_sort_action"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_sort_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@android:color/white" />
    </LinearLayout>

    <!-- 非内容状态提示：内容列表展示时由代码隐藏，不占位 -->
    <TextView
        android:id="@+id/text_repositories_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_repositories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_2"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="32dp"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:requiresFadingEdge="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_load_more_repositories"
        style="@style/Widget.SunsetGitHub.Material.GlobalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:text="@string/dashboard_load_more_repositories"
        android:visibility="gone" />
</LinearLayout>