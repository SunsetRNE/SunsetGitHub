<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/github_canvas" android:fillViewport="true" tools:context=".ui.profile.ProfileFragment">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/page_horizontal_padding" android:paddingVertical="@dimen/page_vertical_padding">
    <com.google.android.material.card.MaterialCardView android:id="@+id/card_profile_state" style="@style/Widget.SunsetGitHub.Material.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardUseCompatPadding="false">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/card_inner_padding">
        <TextView android:id="@+id/text_profile_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body" tools:text="正在加载个人页面……" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_profile_retry" style="@style/Widget.SunsetGitHub.Material.GlobalButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/profile_retry" android:visibility="gone" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout android:id="@+id/container_profile_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
      <com.google.android.material.card.MaterialCardView style="@style/Widget.SunsetGitHub.Material.Card" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="24dp" app:cardUseCompatPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
          <FrameLayout android:layout_width="match_parent" android:layout_height="112dp" android:clipChildren="false" android:clipToPadding="false">
            <View android:layout_width="match_parent" android:layout_height="66dp" android:background="@drawable/bg_profile_cover" />
            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/image_profile_avatar" android:layout_width="76dp" android:layout_height="76dp" android:layout_gravity="bottom|start" android:layout_marginStart="16dp" android:contentDescription="@string/profile_avatar_content_description" android:padding="3dp" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.SunsetGitHub.Circle" app:strokeColor="@color/github_surface" app:strokeWidth="4dp" />
          </FrameLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="15dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:gravity="top" android:orientation="horizontal">
              <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/text_profile_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.ProfileName" tools:text="The Octocat" />
                <TextView android:id="@+id/text_profile_login" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body" tools:text="@octocat" />
              </LinearLayout>
              <TextView android:id="@+id/text_profile_cache_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/bg_profile_status_pill" android:paddingHorizontal="8dp" android:paddingVertical="5dp" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.StatusPill" tools:text="已缓存" />
            </LinearLayout>
            <TextView android:id="@+id/text_profile_bio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_profile_bio_empty" android:paddingHorizontal="10dp" android:paddingVertical="9dp" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body" tools:text="这个用户还没有填写个人简介。" />
            <TextView android:id="@+id/text_profile_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" tools:text="📍 San Francisco · 🏢 GitHub" />
            <TextView android:id="@+id/text_profile_account_footnote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" tools:text="加入 2024-01-01 · 更新 2024-06-01 · 缓存于 09:30" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:baselineAligned="false" android:orientation="horizontal">
              <TextView android:id="@+id/text_profile_followers_stat" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@drawable/bg_profile_overview_tile" android:gravity="center" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" tools:text="关注者\n10" />
              <TextView android:id="@+id/text_profile_following_stat" android:layout_width="0dp" android:layout_height="56dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_profile_overview_tile" android:gravity="center" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" tools:text="正在关注\n2" />
              <TextView android:id="@+id/text_profile_repos_stat" android:layout_width="0dp" android:layout_height="56dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_profile_overview_tile" android:gravity="center" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" tools:text="仓库\n8" />
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <com.google.android.material.card.MaterialCardView style="@style/Widget.SunsetGitHub.Material.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/card_spacing" app:cardCornerRadius="22dp" app:cardUseCompatPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_section_overview" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Title" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/profile_overview_hint" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" />
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:baselineAligned="false" android:orientation="horizontal">
            <LinearLayout android:id="@+id/item_profile_ov_repos" style="@style/Widget.SunsetGitHub.OverviewItem" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_ov_public_repos" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.OverviewKey" /><TextView android:id="@+id/text_profile_ov_repos_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.OverviewValue" tools:text="8" /><TextView android:id="@+id/text_profile_ov_source_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.OverviewHint" tools:text="6 source · 2 fork" /></LinearLayout>
            <LinearLayout android:id="@+id/item_profile_ov_contributions" style="@style/Widget.SunsetGitHub.OverviewItem" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_overview_contributions" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.OverviewKey" /><TextView android:id="@+id/text_profile_ov_contributions_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.OverviewValue" tools:text="812" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/profile_overview_contributions_hint" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.OverviewHint" /></LinearLayout>
          </LinearLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:baselineAligned="false" android:orientation="horizontal">
            <LinearLayout android:id="@+id/item_profile_ov_primary_language" style="@style/Widget.SunsetGitHub.OverviewItem" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_overview_primary_language" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.OverviewKey" /><TextView android:id="@+id/text_profile_ov_primary_language_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.OverviewValue" tools:text="Kotlin" /><TextView android:id="@+id/text_profile_ov_primary_language_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.OverviewHint" tools:text="38% · 5 个仓库" /></LinearLayout>
            <LinearLayout android:id="@+id/item_profile_ov_gists" style="@style/Widget.SunsetGitHub.OverviewItem" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_ov_gists" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.OverviewKey" /><TextView android:id="@+id/text_profile_ov_gists_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.OverviewValue" tools:text="2" /><TextView android:id="@+id/text_profile_ov_issues_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.OverviewHint" tools:text="0 个打开的议题" /></LinearLayout>
          </LinearLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:background="@drawable/bg_profile_overview_tile" android:orientation="vertical" android:padding="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/text_profile_language_section_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/profile_language_distribution" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.SectionLabel" /><TextView android:id="@+id/text_profile_language_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" tools:text="12 个仓库有语言数据" /></LinearLayout>
            <LinearLayout android:id="@+id/container_profile_language_bar" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="10dp" android:background="@drawable/bg_lang_bar_track" android:clipToOutline="true" android:orientation="horizontal" />
            <LinearLayout android:id="@+id/container_profile_language_legend" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />
            <TextView android:id="@+id/text_profile_language_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/profile_language_empty_inline" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body" android:visibility="gone" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Profile contribution and repository sections -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/card_profile_contributions" style="@style/Widget.SunsetGitHub.Material.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/card_spacing" app:cardCornerRadius="22dp" app:cardUseCompatPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/card_inner_padding">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/profile_contributions_title" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Title" />
                <TextView android:id="@+id/text_profile_contribution_settings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_contributions_settings" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" />
            </LinearLayout>
            <TextView android:id="@+id/text_profile_contribution_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body" tools:text="过去一年有 812 次贡献" />
            <HorizontalScrollView android:id="@+id/scroll_profile_contribution_calendar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" android:fillViewport="false" android:overScrollMode="ifContentScrolls" android:scrollbars="none">
                <com.Sunset.REN.GitHub.ui.profile.ContributionCalendarView android:id="@+id/view_profile_contribution_calendar" android:layout_width="wrap_content" android:layout_height="122dp" />
            </HorizontalScrollView>
            <TextView android:id="@+id/text_profile_contribution_learn_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:text="@string/profile_contributions_learn_more" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" />
            <LinearLayout android:id="@+id/container_profile_contribution_legend" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:gravity="end|center_vertical" android:orientation="horizontal" />
            <View android:id="@+id/divider_profile_contribution_overview" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="-12dp" android:layout_marginTop="@dimen/space_3" android:background="@color/github_divider" />
            <TextView android:id="@+id/text_profile_activity_overview_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" android:text="@string/profile_activity_overview_title" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Title" />
            <TextView android:id="@+id/text_profile_activity_overview_repositories" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body" tools:text="参与了 SunsetGitHub 等仓库" />
            <com.Sunset.REN.GitHub.ui.profile.ContributionActivityOverviewView android:id="@+id/view_profile_activity_overview" android:layout_width="match_parent" android:layout_height="148dp" android:layout_marginTop="0dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/text_profile_contribution_activity_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/profile_contribution_activity_title" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Title" />
                <TextView android:id="@+id/text_profile_contribution_year" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_stat_cell" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body" tools:text="2026 年" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/text_profile_contribution_activity_month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.SectionLabel" tools:text="2026年7月" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_marginStart="@dimen/space_3" android:layout_weight="1" android:background="@color/github_divider" />
            </LinearLayout>
            <TextView android:id="@+id/text_profile_contribution_activity_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="28dp" android:layout_marginTop="@dimen/space_4" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body" tools:text="提交 19 · 议题 0 · 拉取请求 0 · 代码审查 0" />
            <TextView android:id="@+id/text_profile_contribution_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_2" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" android:visibility="gone" tools:text="贡献墙加载失败" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:id="@+id/card_profile_repositories" style="@style/Widget.SunsetGitHub.Material.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/card_spacing" app:cardCornerRadius="22dp" app:cardUseCompatPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/card_inner_padding">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_featured_repositories" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Title" />
                <TextView android:id="@+id/text_profile_repositories_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/profile_featured_repositories_hint" android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body" />
            </LinearLayout>
            <LinearLayout android:id="@+id/container_profile_repositories" android:layout_width="match_parent" android:layout_height="wrap_content" android:divider="@drawable/divider_repository_contents" android:orientation="vertical" android:showDividers="beginning|middle" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
  </LinearLayout>
</ScrollView>
