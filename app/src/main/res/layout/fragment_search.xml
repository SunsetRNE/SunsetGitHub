<?xml version="1.0" encoding="utf-8"?>
<!--
  全局搜索浮层（DialogFragment 全屏 modal，B 方案：常驻 scrim 遮罩）。
  - scrim_search_overlay：全屏半透明遮罩，透出底层首页并整体变暗（含导航栏区域）。
  - bar_search：顶部不透明搜索栏，浮在 scrim 之上。
  - 内容区默认透明，露出变暗的首页；进入「结果/加载/消息」态时由代码把结果面板显示出来。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.search.SearchFragment">

    <!-- 遮罩层：全屏，透出底层首页并变暗；点击空白区可关闭 -->
    <View
        android:id="@+id/scrim_search_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/github_search_scrim" />

    <!-- 浮层内容：顶部搜索栏（不透明）+ 下方内容区（默认透明，露出 scrim） -->
    <LinearLayout
        android:id="@+id/panel_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部搜索输入行：不透明，浮在遮罩之上 -->
        <LinearLayout
            android:id="@+id/bar_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/github_surface"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/page_horizontal_padding"
            android:paddingVertical="@dimen/space_2">

            <ImageButton
                android:id="@+id/button_search_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search_back_content_description"
                android:padding="8dp"
                android:rotation="180"
                android:src="@drawable/ic_chevron_right_24" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_inline"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/search_icon_content_description"
                    android:src="@drawable/ic_search_24" />

                <EditText
                    android:id="@+id/edit_search_query"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp"
                    android:singleLine="true"
                    android:textColor="@color/github_text_primary"
                    android:textColorHint="@color/github_text_muted"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/button_clear_search_query"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_clear_content_description"
                    android:padding="6dp"
                    android:src="@drawable/ic_close_24"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- 类型建议容器：浮在变暗背景上，输入关键词后展示，自带不透明卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_search_suggestions"
            style="@style/Widget.SunsetGitHub.Material.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/page_horizontal_padding"
            android:layout_marginTop="@dimen/space_2"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/container_search_suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/card_inner_padding"
                android:paddingVertical="@dimen/space_2" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 结果区：进入结果/加载/消息态时用不透明背景铺满，盖住变暗背景 -->
        <FrameLayout
            android:id="@+id/container_search_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/github_canvas"
            android:visibility="gone">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/page_horizontal_padding"
                    android:paddingBottom="@dimen/page_vertical_padding">

                    <!-- 状态提示行 -->
                    <TextView
                        android:id="@+id/text_search_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="@dimen/space_2"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                        android:visibility="gone"
                        tools:text="共 128 个匹配仓库"
                        tools:visibility="visible" />

                    <!-- 结果列表容器：与个人仓库页保持一致，不再额外套 MaterialCard 外框。 -->
                    <LinearLayout
                        android:id="@+id/card_search_results"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/container_search_results"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- 翻页控件：上一页 / 页码 / 下一页。翻到已访问过的页走缓存，不重复请求，缓解限流。 -->
                <LinearLayout
                    android:id="@+id/container_search_pagination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_search_prev_page"
                        style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/search_page_prev" />

                    <TextView
                        android:id="@+id/text_search_page_indicator"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                        tools:text="第 1 页" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_search_next_page"
                        style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/search_page_next" />
                </LinearLayout>

                    <!-- 空闲/空结果/错误等状态文案 -->
                    <TextView
                        android:id="@+id/text_search_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                        android:visibility="gone"
                        tools:text="输入关键词后选择搜索类型。"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_search_action"
                        style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:visibility="gone"
                        tools:text="重试" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>