<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_auth_step_card"
    android:orientation="horizontal"
    android:padding="14dp">
    <TextView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_auth_step_number" android:gravity="center" android:text="3" android:textColor="@color/github_accent" android:textStyle="bold" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="完成授权" android:textColor="@color/github_text_primary" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="你在 GitHub 页面确认后，应用自动保存账号并进入首页。" android:textColor="@color/github_text_secondary" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>