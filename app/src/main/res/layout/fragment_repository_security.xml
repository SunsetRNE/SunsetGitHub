<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_canvas"
    tools:context=".ui.repo.RepositorySecurityFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="88dp">

            <TextView
                android:id="@+id/text_repository_security_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                android:textColor="@color/github_text_secondary"
                android:visibility="gone"
                tools:text="正在加载仓库安全…" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_repository_security_retry"
                style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/repository_security_retry"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/container_repository_security_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_repository_empty_state_panel"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <View
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@color/github_skeleton" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="170dp"
                                android:layout_height="16dp"
                                android:background="@color/github_skeleton" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:layout_marginTop="9dp"
                                android:background="@color/github_skeleton" />

                            <View
                                android:layout_width="210dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="7dp"
                                android:background="@color/github_skeleton" />
                        </LinearLayout>

                        <View
                            android:layout_width="58dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="8dp"
                            android:background="@color/github_skeleton" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/github_chip_background"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingHorizontal="10dp">

                            <View
                                android:layout_width="34dp"
                                android:layout_height="15dp"
                                android:background="@color/github_skeleton" />

                            <View
                                android:layout_width="64dp"
                                android:layout_height="11dp"
                                android:layout_marginTop="7dp"
                                android:background="@color/github_skeleton" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingHorizontal="10dp">

                            <View
                                android:layout_width="42dp"
                                android:layout_height="15dp"
                                android:background="@color/github_skeleton" />

                            <View
                                android:layout_width="54dp"
                                android:layout_height="11dp"
                                android:layout_marginTop="7dp"
                                android:background="@color/github_skeleton" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingHorizontal="10dp">

                            <View
                                android:layout_width="28dp"
                                android:layout_height="15dp"
                                android:background="@color/github_skeleton" />

                            <View
                                android:layout_width="58dp"
                                android:layout_height="11dp"
                                android:layout_marginTop="7dp"
                                android:background="@color/github_skeleton" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_repository_empty_state_panel"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <View
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@color/github_skeleton" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="150dp"
                                android:layout_height="14dp"
                                android:background="@color/github_skeleton" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:layout_marginTop="8dp"
                                android:background="@color/github_skeleton" />
                        </LinearLayout>

                        <View
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@color/github_skeleton" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <View
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@color/github_skeleton" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="130dp"
                                android:layout_height="14dp"
                                android:background="@color/github_skeleton" />

                            <View
                                android:layout_width="230dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="8dp"
                                android:background="@color/github_skeleton" />
                        </LinearLayout>

                        <View
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@color/github_skeleton" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_repository_security_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/card_repository_security_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_repository_empty_state_panel"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/text_repository_security_summary_symbol"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:gravity="center"
                            android:text="!"
                            android:textStyle="bold"
                            android:textColor="@color/github_attention"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/text_repository_security_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/repository_security_overview_title"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                                android:textColor="@color/github_text_primary"
                                android:textStyle="bold"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/text_repository_security_summary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                                android:textColor="@color/github_text_secondary"
                                tools:text="部分安全功能需要配置。查看告警并补齐缺失保护。" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/text_repository_security_summary_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_pill"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="@string/repository_security_badge_attention"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                            android:textColor="@color/github_attention"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/container_repository_security_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/github_chip_background"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingHorizontal="10dp">

                            <TextView
                                android:id="@+id/text_repository_security_stat_alerts"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.StatNumber"
                                tools:text="1" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/repository_security_stat_open_alerts"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.StatLabel" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingHorizontal="10dp">

                            <TextView
                                android:id="@+id/text_repository_security_stat_ready"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.StatNumber"
                                tools:text="2/4" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/repository_security_stat_ready"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.StatLabel" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingHorizontal="10dp">

                            <TextView
                                android:id="@+id/text_repository_security_stat_setup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.StatNumber"
                                tools:text="2" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/repository_security_stat_setup"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.StatLabel" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/container_repository_security_overview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/repository_security_entry_points_title"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                            android:textColor="@color/github_text_primary"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/repository_security_entry_points_caption"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/container_repository_security_probes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_repository_empty_state_panel"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/container_repository_security_selected_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_repository_empty_state_panel"
                    android:orientation="vertical"
                    android:padding="12dp" />

                <HorizontalScrollView
                    android:id="@+id/scroll_repository_security_alert_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/container_repository_security_alert_filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <HorizontalScrollView
                    android:id="@+id/scroll_repository_security_alert_state_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/container_repository_security_alert_state_filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/container_repository_security_alerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_repository_empty_state_panel"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_repository_security_alerts_load_more"
                        style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/repository_security_alerts_load_more"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/container_repository_security_notices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_repository_empty_state_panel"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
