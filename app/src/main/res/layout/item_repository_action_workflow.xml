<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_repository_action_workflow_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.RepositoryName"
            android:textColor="@color/github_text_primary"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="CI" />

        <TextView
            android:id="@+id/text_repository_action_workflow_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
            android:textColor="@color/github_text_secondary"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="active · .github/workflows/ci.yml · push, workflow_dispatch" />

        <TextView
            android:id="@+id/text_repository_action_workflow_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
            android:textColor="@color/github_text_secondary"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="2025-01-02T12:34:56Z" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:gravity="center"
        android:minWidth="92dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_repository_action_workflow_badge"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            tools:text="可触发" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_repository_action_workflow_dispatch"
            style="@style/Widget.SunsetGitHub.Material.GlobalButton"
            android:layout_width="92dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/repository_actions_workflow_run_short_button"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>