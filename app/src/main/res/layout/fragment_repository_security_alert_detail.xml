<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_repository_security_alert_detail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_canvas"
    android:fillViewport="true"
    tools:context=".ui.repo.RepositorySecurityAlertDetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_horizontal_padding"
        android:paddingVertical="@dimen/page_vertical_padding">

        <TextView
            android:id="@+id/text_repository_security_alert_detail_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
            android:visibility="gone"
            tools:text="正在刷新安全告警详情……"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_repository_security_alert_detail_retry"
            style="@style/Widget.SunsetGitHub.Material.GlobalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/repository_security_alert_detail_retry"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/container_repository_security_alert_detail_card"
            style="@style/Widget.SunsetGitHub.Material.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/text_repository_security_alert_detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Title"
                    tools:text="Prototype pollution in dependency" />

                <TextView
                    android:id="@+id/text_repository_security_alert_detail_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                    tools:text="Dependabot · open · high" />

                <TextView
                    android:id="@+id/text_repository_security_alert_detail_created"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                    android:visibility="gone"
                    tools:text="2025-01-01T10:00:00Z"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/text_repository_security_alert_detail_details_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/repository_security_alert_detail_details_title"
                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Title"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/container_repository_security_alert_detail_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_repository_security_alert_detail_open"
                    style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/repository_security_alert_detail_open_in_github"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>