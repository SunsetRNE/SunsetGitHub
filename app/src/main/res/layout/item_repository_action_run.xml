<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <View
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="2dp"
        android:background="@drawable/bg_repository_action_run_indicator" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_repository_action_run_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.RepositoryName"
            android:textColor="@color/github_text_primary"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Build and test" />

        <TextView
            android:id="@+id/text_repository_action_run_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
            android:textColor="@color/github_text_secondary"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="push · completed · main · a1b2c3d" />

        <TextView
            android:id="@+id/text_repository_action_run_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
            android:textColor="@color/github_text_secondary"
            tools:text="2025-01-02T12:34:56Z" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_repository_action_run_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_repository_action_run_badge"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Pill"
        android:textColor="@color/github_text_primary"
        tools:text="completed" />
</LinearLayout>