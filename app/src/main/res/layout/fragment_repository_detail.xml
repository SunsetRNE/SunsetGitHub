<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_canvas"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="0dp"
    tools:context=".ui.repo.RepositoryDetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_horizontal_padding"
        android:paddingVertical="@dimen/page_vertical_padding">

        <include
            android:id="@+id/include_repository_detail_skeleton"
            layout="@layout/layout_repository_detail_skeleton" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/container_repository_detail_header_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardUseCompatPadding="false"
            style="@style/Widget.SunsetGitHub.Material.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_inner_padding">

                <TextView
                    android:id="@+id/text_repository_detail_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                    android:visibility="gone"
                    tools:text="正在加载仓库详情……" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_repository_detail_retry"
                    style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/repository_detail_retry"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/container_repository_detail_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/container_repository_owner"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/image_repository_owner_avatar"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="@string/repository_detail_owner_avatar_content_description"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.SunsetGitHub.Circle"
                                app:strokeColor="@color/github_border"
                                app:strokeWidth="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/text_repository_detail_title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Title"
                                    tools:text="owner/repo" />

                                <TextView
                                    android:id="@+id/text_repository_owner_source"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                                    tools:text="Organization · main" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/container_repository_light_management_actions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_open_repository_in_github"
                                style="@style/Widget.SunsetGitHub.Material.IconButton"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:contentDescription="@string/repository_detail_open_in_github_content_description"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:visibility="gone"
                                app:icon="@drawable/ic_open_in_new_24"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="@color/github_text_secondary" />

                            <!-- Fork 入口已迁移到仓库分区，不再镶嵌在仓库模板操作区。 -->

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_repository_star"
                                style="@style/Widget.SunsetGitHub.Material.IconButton"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="4dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:backgroundTint="@color/icon_button_background_tint"
                                app:icon="@drawable/ic_star_outline_24"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="@color/github_text_secondary"
                                app:strokeColor="@color/icon_button_stroke" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_repository_watch"
                                style="@style/Widget.SunsetGitHub.Material.IconButton"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="4dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:icon="@drawable/ic_visibility_24"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="@color/github_text_secondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_repository_detail_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                        tools:text="Repository description" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_repository_meta_panel"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/repository_detail_meta_tags_title"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                            android:textColor="@color/github_text_secondary"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/container_repository_detail_badges"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/text_repository_visibility_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_repository_badge"
                                android:includeFontPadding="false"
                                android:paddingHorizontal="7dp"
                                android:paddingVertical="2dp"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                                tools:text="公开" />

                            <TextView
                                android:id="@+id/text_repository_language_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/bg_repository_badge"
                                android:includeFontPadding="false"
                                android:paddingHorizontal="7dp"
                                android:paddingVertical="2dp"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                                tools:text="Kotlin" />

                            <TextView
                                android:id="@+id/text_repository_type_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/bg_repository_badge"
                                android:includeFontPadding="false"
                                android:paddingHorizontal="7dp"
                                android:paddingVertical="2dp"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                                tools:text="派生" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/container_repository_detail_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_repository_stat_group"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_repository_detail_stars_stat"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                            android:textStyle="bold"
                            tools:text="★ 10" />

                        <TextView
                            android:id="@+id/text_repository_detail_forks_stat"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                            android:textStyle="bold"
                            tools:text="⑂ 1" />

                        <TextView
                            android:id="@+id/text_repository_detail_issues_stat"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                            android:textStyle="bold"
                            tools:text="Issue 0" />

                        <TextView
                            android:id="@+id/text_repository_detail_watchers_stat"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                            android:textStyle="bold"
                            tools:text="👁 2" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_repository_detail_branch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        tools:text="默认分支：main" />

                    <TextView
                        android:id="@+id/text_repository_light_management_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                        android:visibility="gone"
                        tools:text="仓库轻管理操作完成。" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/container_repository_fork_sync_card"
            style="@style/Widget.SunsetGitHub.Material.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing"
            android:visibility="gone"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_inner_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/container_repository_fork_sync_icon"
                        android:layout_width="42dp"
                        android:layout_height="42dp">

                        <TextView
                            android:id="@+id/text_repository_fork_sync_icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.RepositoryName"
                            android:textStyle="bold"
                            tools:text="⑂" />

                        <ProgressBar
                            android:id="@+id/progress_repository_fork_sync_icon"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_repository_fork_sync_kicker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                            android:textStyle="bold"
                            tools:text="Fork 状态" />

                        <TextView
                            android:id="@+id/text_repository_fork_sync_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.RepositoryName"
                            tools:text="领先源仓库 11 个提交" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_repository_fork_sync_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                        android:textStyle="bold"
                        tools:text="可贡献" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_repository_fork_sync_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="53dp"
                    android:layout_marginTop="11dp"
                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                    tools:text="当前分支可向 cctv18/main 贡献更改；同步前建议先确认是否还有上游更新。" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="53dp"
                    android:layout_marginTop="13dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_repository_fork_contribute"
                        style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:singleLine="true"
                        android:text="@string/repository_fork_contribute_action"
                        app:icon="@drawable/ic_git_pull_request_24"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_repository_fork_sync"
                        style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:singleLine="true"
                        android:text="@string/repository_fork_sync_action"
                        app:icon="@drawable/ic_sync_24"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/container_repository_contents_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing"
            app:cardUseCompatPadding="false"
            style="@style/Widget.SunsetGitHub.Material.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/container_repository_contents_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_repository_contents_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/repository_contents_title_root"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.RepositoryName" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_repository_file_actions_menu"
                            style="@style/Widget.SunsetGitHub.Material.IconButton"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/repository_file_actions_content_description"
                            android:visibility="gone"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            app:icon="@drawable/ic_menu_24"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="@color/github_surface"
                            app:backgroundTint="@color/github_text_primary"
                            app:strokeColor="@color/github_text_primary" />

                        <LinearLayout
                            android:id="@+id/container_repository_file_write_actions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_repository_create_file"
                                style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingHorizontal="10dp"
                                android:text="@string/repository_file_create_short_action"
                                android:textSize="12sp"
                                app:icon="@drawable/ic_add_24"
                                app:iconGravity="textStart"
                                app:iconPadding="4dp"
                                app:iconSize="16dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/button_repository_upload_file"
                                style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_marginStart="6dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingHorizontal="10dp"
                                android:text="@string/repository_file_upload_short_action"
                                android:textSize="12sp"
                                app:icon="@drawable/ic_file_24"
                                app:iconGravity="textStart"
                                app:iconPadding="4dp"
                                app:iconSize="16dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_repository_contents_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                        tools:text="已加载 8 个条目。" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_repository_contents_retry"
                        style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/repository_contents_retry"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/container_repository_contents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/container_repository_file_preview_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing"
            app:cardUseCompatPadding="false"
            style="@style/Widget.SunsetGitHub.Material.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_inner_padding">

                <TextView
                    android:id="@+id/text_repository_file_preview_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/repository_file_preview_title"
                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Title" />

                <TextView
                    android:id="@+id/text_repository_file_preview_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/repository_file_preview_hint"
                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body" />

                <LinearLayout
                    android:id="@+id/container_repository_file_preview_meta_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_repository_meta_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/text_repository_file_preview_type_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_repository_badge"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                        tools:text="Markdown" />

                    <TextView
                        android:id="@+id/text_repository_file_preview_source_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_repository_badge"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                        tools:text="来自 main" />

                    <TextView
                        android:id="@+id/text_repository_file_preview_render_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_repository_badge"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                        tools:text="已渲染" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_repository_file_preview_retry"
                    style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/repository_file_preview_retry"
                    android:visibility="gone" />

                <ScrollView
                    android:id="@+id/scroll_repository_file_preview_document"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fillViewport="true"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/text_repository_file_preview_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_file_preview_document"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="4dp"
                        android:padding="16dp"
                        android:textColor="@color/github_text_primary"
                        android:textIsSelectable="true"
                        android:textSize="14sp"
                        tools:text="# README" />
                </ScrollView>

                <HorizontalScrollView
                    android:id="@+id/scroll_repository_file_preview_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fillViewport="true"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/text_repository_file_preview_content_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_file_preview_code"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:minWidth="320dp"
                        android:padding="12dp"
                        android:scrollHorizontally="true"
                        android:textColor="@color/github_text_primary"
                        android:textIsSelectable="true"
                        android:textSize="12sp"
                        android:typeface="monospace"
                        tools:text="1 | fun main() { println('Hello') }" />
                </HorizontalScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/container_repository_sidebar_card"
            style="@style/Widget.SunsetGitHub.Material.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing"
            android:visibility="gone"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
<LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_inner_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_repository_sidebar_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/repository_sidebar_title"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Title" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_create_release"
                            style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="@string/repository_release_create_action"
                            android:textColor="@color/github_surface"
                            android:textSize="13sp"
                            app:backgroundTint="@color/github_text_primary"
                            app:cornerRadius="6dp"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>


                    <TextView
                        android:id="@+id/text_repository_sidebar_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/repository_sidebar_loading"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/container_repository_sidebar_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/card_inner_padding"
                    android:paddingEnd="@dimen/card_inner_padding"
                    android:paddingBottom="@dimen/card_inner_padding" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/container_repository_section_placeholder_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing"
            android:visibility="gone"
            app:cardUseCompatPadding="false"
            style="@style/Widget.SunsetGitHub.Material.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_inner_padding">

                <TextView
                    android:id="@+id/text_repository_section_placeholder_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Title"
                    tools:text="Issues" />

                <TextView
                    android:id="@+id/text_repository_section_placeholder_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                    tools:text="该分区暂为占位，后续接入真实仓库数据。" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_open_repository_section_in_github"
                    style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/repository_section_open_native_stub"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/container_repository_more_sections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:divider="@drawable/divider_repository_contents"
                    android:orientation="vertical"
                    android:showDividers="middle"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>