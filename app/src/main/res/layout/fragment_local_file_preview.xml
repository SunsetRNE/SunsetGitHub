<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_canvas"
    tools:context=".ui.filemanager.LocalFilePreviewFragment">

    <LinearLayout
        android:id="@+id/container_local_file_preview_top_bar"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_file_preview_top_bar"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_local_file_preview_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                android:textColor="@color/github_file_preview_top_bar_text_primary"
                android:textSize="13sp"
                android:textStyle="normal"
                tools:text="README.md" />

            <TextView
                android:id="@+id/text_local_file_preview_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                android:textColor="@color/github_file_preview_top_bar_text_secondary"
                android:textSize="11sp"
                tools:text="1:1 UTF-8" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_local_file_preview_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="/storage/emulated/0/Download/README.md" />

        <TextView
            android:id="@+id/text_local_file_preview_type_chip"
            style="@style/Widget.SunsetGitHub.FilePreviewBadge.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="Markdown"
            tools:visibility="gone" />

        <TextView
            android:id="@+id/text_local_file_preview_access_pill"
            style="@style/Widget.SunsetGitHub.FilePreviewBadge.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="只读"
            tools:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/container_local_file_preview_editor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_file_preview_code"
        android:clipToOutline="true"
        app:layout_constraintBottom_toTopOf="@id/container_local_file_preview_search"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/container_local_file_preview_top_bar">

        <ScrollView
            android:id="@+id/scroll_local_file_preview_markdown"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingHorizontal="@dimen/page_horizontal_padding"
            android:paddingVertical="@dimen/space_3"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_local_file_preview_markdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                android:textColor="@color/github_text_primary"
                tools:text="# README\n\nMarkdown preview" />
        </ScrollView>

        <FrameLayout
            android:id="@+id/container_local_file_preview_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/page_horizontal_padding"
            android:visibility="gone">

            <ImageView
                android:id="@+id/image_local_file_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@string/local_file_preview_image_content_description"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <ScrollView
            android:id="@+id/scroll_local_file_preview_archive"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingHorizontal="@dimen/page_horizontal_padding"
            android:paddingVertical="@dimen/space_3"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_local_file_preview_archive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                android:textColor="@color/github_text_primary"
                tools:text="ZIP archive\n\nfiles/README.md" />
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/container_local_file_preview_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_file_preview_panel"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_2"
        android:paddingVertical="@dimen/space_1"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/container_local_file_preview_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edit_local_file_preview_search_query"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/local_file_preview_search_field_height"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_inline"
                    android:hint="@string/local_file_preview_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:singleLine="true"
                    android:textColor="@color/github_text_primary"
                    android:textColorHint="@color/github_text_muted"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_local_file_preview_find_previous"
                    style="@style/Widget.SunsetGitHub.Material.FilePreviewActionButton"
                    android:layout_width="@dimen/local_file_preview_search_icon_button_size"
                    android:layout_height="@dimen/local_file_preview_search_icon_button_size"
                    android:layout_marginStart="@dimen/space_1"
                    android:contentDescription="@string/local_file_preview_find_previous"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="0dp"
                    android:text="@string/local_file_preview_find_previous_short"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_local_file_preview_find_next"
                    style="@style/Widget.SunsetGitHub.Material.FilePreviewActionButton"
                    android:layout_width="@dimen/local_file_preview_search_icon_button_size"
                    android:layout_height="@dimen/local_file_preview_search_icon_button_size"
                    android:layout_marginStart="@dimen/space_1"
                    android:contentDescription="@string/local_file_preview_find_next"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="0dp"
                    android:text="@string/local_file_preview_find_next_short"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_local_file_preview_regex_help"
                    style="@style/Widget.SunsetGitHub.Material.FilePreviewActionButton"
                    android:layout_width="@dimen/local_file_preview_search_icon_button_size"
                    android:layout_height="@dimen/local_file_preview_search_icon_button_size"
                    android:layout_marginStart="@dimen/space_1"
                    android:contentDescription="@string/local_file_preview_regex_help_title"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="0dp"
                    android:text="@string/local_file_preview_regex_help_short"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edit_local_file_preview_replace_text"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/local_file_preview_search_field_height"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_inline"
                    android:hint="@string/local_file_preview_replace_hint"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:singleLine="true"
                    android:textColor="@color/github_text_primary"
                    android:textColorHint="@color/github_text_muted"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_local_file_preview_replace_current"
                    style="@style/Widget.SunsetGitHub.Material.FilePreviewActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/local_file_preview_search_action_button_height"
                    android:layout_marginStart="@dimen/space_1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/local_file_preview_replace_current"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_local_file_preview_replace_all"
                    style="@style/Widget.SunsetGitHub.Material.FilePreviewActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/local_file_preview_search_action_button_height"
                    android:layout_marginStart="@dimen/space_1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/local_file_preview_replace_all"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/check_local_file_preview_ignore_case"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/local_file_preview_search_option_height"
                    android:minHeight="0dp"
                    android:paddingVertical="0dp"
                    android:text="@string/local_file_preview_search_ignore_case"
                    android:textColor="@color/github_text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/check_local_file_preview_regex"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/local_file_preview_search_option_height"
                    android:layout_marginStart="@dimen/space_2"
                    android:minHeight="0dp"
                    android:paddingVertical="0dp"
                    android:text="@string/local_file_preview_search_regex"
                    android:textColor="@color/github_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/text_local_file_preview_search_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end|center_vertical"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                    android:textColor="@color/github_text_muted"
                    tools:text="3 处匹配" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/container_local_file_preview_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_file_preview_actions"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_1"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_local_file_preview_markdown_toggle"
            style="@style/Widget.SunsetGitHub.Material.FilePreviewActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/local_file_preview_markdown_source"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_local_file_preview_search_toggle"
            style="@style/Widget.SunsetGitHub.Material.FilePreviewActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:text="@string/local_file_preview_search" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_local_file_preview_convert"
            style="@style/Widget.SunsetGitHub.Material.FilePreviewActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:text="@string/local_file_preview_convert" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_local_file_preview_save_as"
            style="@style/Widget.SunsetGitHub.Material.FilePreviewActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:text="@string/local_file_preview_save_as"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_local_file_preview_extract"
            style="@style/Widget.SunsetGitHub.Material.FilePreviewActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:text="@string/local_file_preview_archive_extract"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_local_file_preview_edit"
            style="@style/Widget.SunsetGitHub.Material.FilePreviewPrimaryActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:text="@string/local_file_preview_edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_local_file_preview_undo"
            style="@style/Widget.SunsetGitHub.Material.FilePreviewActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:text="@string/local_file_preview_undo"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_local_file_preview_redo"
            style="@style/Widget.SunsetGitHub.Material.FilePreviewActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:text="@string/local_file_preview_redo"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_local_file_preview_cancel"
            style="@style/Widget.SunsetGitHub.Material.FilePreviewActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_local_file_preview_save"
            style="@style/Widget.SunsetGitHub.Material.FilePreviewPrimaryActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:text="@string/local_file_preview_save"
            android:visibility="gone" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>