<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_canvas"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="0dp"
    tools:context=".ui.notifications.NotificationDetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/text_notification_detail_repository"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
            android:textColor="@color/github_text_muted"
            tools:text="owner/repository" />

        <TextView
            android:id="@+id/text_notification_detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Title"
            android:textColor="@color/github_text_primary"
            tools:text="CodeQL workflow run failed for main branch" />

        <LinearLayout
            android:id="@+id/container_notification_detail_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_notifications_empty_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/text_notification_detail_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                android:textColor="@color/github_text_primary" />

            <TextView
                android:id="@+id/text_notification_detail_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                android:textColor="@color/github_text_secondary" />

            <TextView
                android:id="@+id/text_notification_detail_updated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                android:textColor="@color/github_text_secondary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/notification_detail_quick_actions"
            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
            android:textColor="@color/github_text_primary"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_notification_detail_mark_read"
                style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notification_action_mark_read" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_notification_detail_done"
                style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/notification_action_done" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="start"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_notification_detail_subscribe"
                    style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/notification_action_subscribe" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_notification_detail_unsubscribe"
                    style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notification_action_unsubscribe" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/notification_detail_open_links"
            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
            android:textColor="@color/github_text_primary"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_notification_detail_open_subject"
                style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notification_action_open_subject" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_notification_detail_open_latest"
                style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/notification_action_open_latest_comment" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_notification_detail_open_repo"
                style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/notification_action_open_repository" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
