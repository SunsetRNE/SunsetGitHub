<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android='http://schemas.android.com/apk/res/android'
    xmlns:app='http://schemas.android.com/apk/res-auto'
    xmlns:tools='http://schemas.android.com/tools'
    android:layout_width='match_parent'
    android:layout_height='match_parent'
    android:background='@color/github_canvas'
    tools:context='.ui.repo.RepositoryAgentsOfficialFragment'>

    <ScrollView
        android:id='@+id/scroll_repository_agents_official'
        android:layout_width='match_parent'
        android:layout_height='match_parent'
        android:clipToPadding='false'
        android:fillViewport='true'
        android:paddingBottom='120dp'>

        <LinearLayout
            android:layout_width='match_parent'
            android:layout_height='wrap_content'
            android:orientation='vertical'
            android:paddingStart='16dp'
            android:paddingTop='18dp'
            android:paddingEnd='16dp'
            android:paddingBottom='96dp'>

            <TextView
                android:id='@+id/text_repository_agents_repository_label'
                android:layout_width='match_parent'
                android:layout_height='wrap_content'
                android:ellipsize='end'
                android:singleLine='true'
                android:textAppearance='@style/TextAppearance.SunsetGitHub.Material.Meta'
                android:textColor='@color/github_text_secondary'
                tools:text='SunsetRNE/ReSukiSU_CI' />

                <LinearLayout
                    android:layout_width='match_parent'
                    android:layout_height='wrap_content'
                    android:layout_marginTop='8dp'
                    android:gravity='center_vertical'
                    android:orientation='horizontal'>

                    <TextView
                        android:id='@+id/button_repository_agents_sidebar'
                        android:layout_width='40dp'
                        android:layout_height='40dp'
                        android:layout_marginEnd='12dp'
                        android:background='@color/github_surface'
                        android:clickable='true'
                        android:focusable='true'
                        android:foreground='?attr/selectableItemBackground'
                        android:gravity='center'
                        android:text='☰'
                        android:textColor='@color/github_text_secondary'
                        android:textSize='20sp' />

                    <TextView
                        android:layout_width='0dp'
                        android:layout_height='wrap_content'
                        android:layout_weight='1'
                        android:text='@string/repository_agents_sessions_title'
                        android:textAppearance='@style/TextAppearance.SunsetGitHub.Material.Title'
                        android:textColor='@color/github_text_primary'
                        android:textSize='28sp' />

                    <TextView
                        android:id='@+id/text_repository_agents_state_chip'
                        android:layout_width='wrap_content'
                        android:layout_height='wrap_content'
                        android:gravity='center'
                        android:includeFontPadding='false'
                        android:minHeight='28dp'
                        android:paddingStart='10dp'
                        android:paddingEnd='10dp'
                        android:textAppearance='@style/TextAppearance.SunsetGitHub.Material.Meta'
                        android:textStyle='bold'
                        tools:text='No sessions' />
                </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width='match_parent'
                android:layout_height='44dp'
                android:layout_marginTop='18dp'
                app:cardBackgroundColor='@color/github_surface'
                app:cardCornerRadius='8dp'
                app:cardElevation='0dp'
                app:strokeColor='@color/github_border'
                app:strokeWidth='1dp'>

                <LinearLayout
                    android:layout_width='match_parent'
                    android:layout_height='match_parent'
                    android:gravity='center_vertical'
                    android:orientation='horizontal'>

                    <EditText
                        android:id='@+id/edit_repository_agents_query'
                        android:layout_width='0dp'
                        android:layout_height='match_parent'
                        android:layout_weight='1'
                        android:background='@android:color/transparent'
                        android:imeOptions='actionSearch'
                        android:inputType='text'
                        android:paddingStart='12dp'
                        android:paddingEnd='8dp'
                        android:singleLine='true'
                        android:text='@string/repository_agents_search_query'
                        android:textAppearance='@style/TextAppearance.SunsetGitHub.Material.Body'
                        android:textColor='@color/github_text_primary' />

                    <View
                        android:layout_width='1dp'
                        android:layout_height='match_parent'
                        android:background='@color/github_border' />

                    <TextView
                        android:id='@+id/button_repository_agents_query'
                        android:layout_width='44dp'
                        android:layout_height='match_parent'
                        android:foreground='?attr/selectableItemBackground'
                        android:gravity='center'
                        android:text='⌕'
                        android:textColor='@color/github_text_secondary'
                        android:textSize='22sp' />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id='@+id/text_repository_agents_filter_summary'
                android:layout_width='match_parent'
                android:layout_height='wrap_content'
                android:layout_marginTop='8dp'
                android:ellipsize='end'
                android:singleLine='true'
                android:textAppearance='@style/TextAppearance.SunsetGitHub.Material.Meta'
                android:textColor='@color/github_text_secondary'
                android:visibility='gone'
                tools:text='Filtered by Completed · Cloud Agents'
                tools:visibility='visible' />

            <com.google.android.material.card.MaterialCardView
                android:id='@+id/card_repository_agents_notice'
                android:layout_width='match_parent'
                android:layout_height='wrap_content'
                android:layout_marginTop='14dp'
                android:visibility='gone'
                app:cardBackgroundColor='@color/github_attention_soft'
                app:cardCornerRadius='12dp'
                app:cardElevation='0dp'
                app:strokeColor='@color/github_attention_soft_border'
                app:strokeWidth='1dp'
                tools:visibility='visible'>

                <LinearLayout
                    android:layout_width='match_parent'
                    android:layout_height='wrap_content'
                    android:orientation='vertical'
                    android:padding='12dp'>

                    <TextView
                        android:id='@+id/text_repository_agents_notice_title'
                        android:layout_width='match_parent'
                        android:layout_height='wrap_content'
                        android:textAppearance='@style/TextAppearance.SunsetGitHub.Material.Body'
                        android:textColor='@color/github_text_primary'
                        android:textStyle='bold'
                        tools:text='Agents unavailable' />

                    <TextView
                        android:id='@+id/text_repository_agents_notice_body'
                        android:layout_width='match_parent'
                        android:layout_height='wrap_content'
                        android:layout_marginTop='4dp'
                        android:lineSpacingExtra='2dp'
                        android:textAppearance='@style/TextAppearance.SunsetGitHub.Material.Meta'
                        android:textColor='@color/github_text_secondary'
                        tools:text='Check Copilot policies, repository settings, or account access.' />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width='match_parent'
                android:layout_height='wrap_content'
                android:layout_marginTop='14dp'
                app:cardBackgroundColor='@color/github_surface'
                app:cardCornerRadius='14dp'
                app:cardElevation='0dp'
                app:strokeColor='@color/github_divider'
                app:strokeWidth='1dp'>

                <LinearLayout
                    android:layout_width='match_parent'
                    android:layout_height='wrap_content'
                    android:orientation='vertical'>

                    <LinearLayout
                        android:layout_width='match_parent'
                        android:layout_height='64dp'
                        android:background='@color/github_notification_chip_background'
                        android:gravity='center_vertical'
                        android:orientation='horizontal'>

                        <LinearLayout
                            android:id='@+id/tab_repository_agents_active'
                            android:layout_width='0dp'
                            android:layout_height='match_parent'
                            android:layout_weight='1'
                            android:clickable='true'
                            android:focusable='true'
                            android:foreground='?attr/selectableItemBackground'
                            android:gravity='center'
                            android:orientation='horizontal'>

                            <TextView
                                android:id='@+id/text_repository_agents_active_label'
                                android:layout_width='wrap_content'
                                android:layout_height='wrap_content'
                                android:text='@string/repository_agents_tab_active'
                                android:textAppearance='@style/TextAppearance.SunsetGitHub.Material.Body' />

                            <TextView
                                android:id='@+id/text_repository_agents_active_count'
                                android:layout_width='wrap_content'
                                android:layout_height='wrap_content'
                                android:layout_marginStart='8dp'
                                android:gravity='center'
                                android:minWidth='34dp'
                                android:minHeight='24dp'
                                android:paddingStart='9dp'
                                android:paddingEnd='9dp'
                                android:textAppearance='@style/TextAppearance.SunsetGitHub.Material.Meta'
                                android:textStyle='bold'
                                tools:text='0' />
                        </LinearLayout>

                        <LinearLayout
                            android:id='@+id/tab_repository_agents_completed'
                            android:layout_width='0dp'
                            android:layout_height='match_parent'
                            android:layout_weight='1'
                            android:clickable='true'
                            android:focusable='true'
                            android:foreground='?attr/selectableItemBackground'
                            android:gravity='center'
                            android:orientation='horizontal'>

                            <TextView
                                android:id='@+id/text_repository_agents_completed_label'
                                android:layout_width='wrap_content'
                                android:layout_height='wrap_content'
                                android:text='@string/repository_agents_tab_completed'
                                android:textAppearance='@style/TextAppearance.SunsetGitHub.Material.Body' />

                            <TextView
                                android:id='@+id/text_repository_agents_completed_count'
                                android:layout_width='wrap_content'
                                android:layout_height='wrap_content'
                                android:layout_marginStart='8dp'
                                android:gravity='center'
                                android:minWidth='34dp'
                                android:minHeight='24dp'
                                android:paddingStart='9dp'
                                android:paddingEnd='9dp'
                                android:textAppearance='@style/TextAppearance.SunsetGitHub.Material.Meta'
                                android:textStyle='bold'
                                tools:text='1' />
                        </LinearLayout>
                        <TextView
                            android:id='@+id/button_repository_agents_filters'
                            android:layout_width='48dp'
                            android:layout_height='match_parent'
                            android:clickable='true'
                            android:focusable='true'
                            android:foreground='?attr/selectableItemBackground'
                            android:gravity='center'
                            android:text='…'
                            android:textColor='@color/github_text_secondary'
                            android:textSize='24sp' />
                    </LinearLayout>

                    <View
                        android:layout_width='match_parent'
                        android:layout_height='1dp'
                        android:background='@color/github_divider' />

                    <LinearLayout
                        android:id='@+id/container_repository_agents_sessions_body'
                        android:layout_width='match_parent'
                        android:layout_height='wrap_content'
                        android:gravity='center'
                        android:minHeight='128dp'
                        android:orientation='vertical'
                        android:padding='20dp'
                        tools:ignore='UselessParent' />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width='match_parent'
                android:layout_height='wrap_content'
                android:layout_marginTop='18dp'
                android:gravity='center_vertical'
                android:orientation='horizontal'>

                <com.google.android.material.button.MaterialButton
                    android:id='@+id/button_repository_agents_retry'
                    style='@style/Widget.SunsetGitHub.Material.Button'
                    android:layout_width='0dp'
                    android:layout_height='wrap_content'
                    android:layout_marginEnd='8dp'
                    android:layout_weight='1'
                    android:text='@string/repository_agents_refresh' />

                <com.google.android.material.button.MaterialButton
                    android:id='@+id/button_repository_agents_open_in_github'
                    style='@style/Widget.SunsetGitHub.Material.GlobalButton'
                    android:layout_width='0dp'
                    android:layout_height='wrap_content'
                    android:layout_marginStart='8dp'
                    android:layout_weight='1'
                    android:text='@string/repository_section_open_in_github' />
            </LinearLayout>

            <TextView
                android:id='@+id/text_repository_agents_ai_note'
                android:layout_width='match_parent'
                android:layout_height='wrap_content'
                android:layout_marginTop='16dp'
                android:gravity='center'
                android:text='@string/repository_agents_ai_note'
                android:textAppearance='@style/TextAppearance.SunsetGitHub.Material.Meta'
                android:textColor='@color/github_text_secondary' />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
