<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/device_flow_code_title"
            android:textColor="@color/github_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_device_flow_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/device_flow_code_preparing"
            android:textColor="@color/github_text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_auth_code_box"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/device_flow_code_label"
                android:textColor="@color/github_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_device_flow_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/github_text_primary"
                android:textIsSelectable="true"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:text="ABCD-1234" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_copy_device_code"
                style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/device_flow_copy_code" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_open_device_browser"
                style="@style/Widget.SunsetGitHub.Material.PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/device_flow_open_browser" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_device_flow_waiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_auth_method_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_flow_waiting_title"
                android:textColor="@color/github_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_device_flow_waiting_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/device_flow_waiting_detail"
                android:textColor="@color/github_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel_device_flow"
            style="@style/Widget.SunsetGitHub.Material.GlobalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_cancel" />
    </LinearLayout>
</ScrollView>