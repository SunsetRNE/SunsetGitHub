<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_canvas"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/page_vertical_padding"
    tools:context=".ui.repo.RepositoryCreateFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_repository_create_hero"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_compact_black_dialog_icon"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="@string/repository_create_current_owner_badge"
                android:textColor="#D9FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/repository_create_page_title"
                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Title"
                android:textColor="@color/white"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/repository_create_page_subtitle"
                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                android:textColor="#C7FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_repository_create_feature_chip"
                    android:text="@string/repository_create_required_name_badge"
                    android:textColor="@color/github_black"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_repository_create_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_compact_black_dialog_icon"
                    android:text="@string/repository_create_ready"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/container_repository_create_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_repository_create_form_shell"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/repository_create_basic_info_section"
                android:textColor="@color/github_black"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/repository_create_name_section"
                android:textColor="@color/github_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_repository_create_name"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_repository_create_input"
                android:hint="@string/repository_create_name_hint"
                android:inputType="textNoSuggestions"
                android:maxLength="100"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/github_black"
                android:textColorHint="@color/github_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/repository_create_description_section"
                android:textColor="@color/github_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_repository_create_description"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_repository_create_input"
                android:gravity="top|start"
                android:hint="@string/repository_create_description_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="350"
                android:minLines="1"
                android:paddingStart="12dp"
                android:paddingTop="9dp"
                android:paddingEnd="12dp"
                android:textColor="@color/github_black"
                android:textColorHint="@color/github_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/repository_create_homepage_section"
                android:textColor="@color/github_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_repository_create_homepage"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_repository_create_input"
                android:hint="@string/repository_create_homepage_hint"
                android:inputType="textUri"
                android:maxLength="512"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/github_black"
                android:textColorHint="@color/github_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/repository_create_homepage_desc"
                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="13dp"
                android:background="@color/github_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/repository_create_visibility_section"
                android:textColor="@color/github_black"
                android:textSize="12sp"
                android:textStyle="bold" />
            <RadioGroup
                android:id="@+id/group_repository_create_visibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radio_repository_create_public"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_repository_create_option_card"
                    android:buttonTint="@color/repository_create_control_tint"
                    android:checked="true"
                    android:gravity="top"
                    android:minHeight="104dp"
                    android:paddingStart="10dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/github_black"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/radio_repository_create_private"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_repository_create_option_card"
                    android:buttonTint="@color/repository_create_control_tint"
                    android:gravity="top"
                    android:minHeight="104dp"
                    android:paddingStart="10dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/github_black"
                    android:textSize="13sp" />
            </RadioGroup>


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="13dp"
                android:background="@color/github_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/repository_create_initialize_section"
                android:textColor="@color/github_black"
                android:textSize="12sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/check_repository_create_readme"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_repository_create_feature_chip"
                android:buttonTint="@color/repository_create_control_tint"
                android:padding="8dp"
                android:text="@string/repository_create_readme"
                android:textColor="@color/github_black"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_repository_create_init_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/repository_create_readme_desc"
                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/repository_create_gitignore_section"
                        android:textColor="@color/github_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.Sunset.REN.GitHub.ui.components.SunsetChipButton
                        android:id="@+id/text_repository_create_gitignore_picker"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_repository_create_input"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/github_black"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/repository_create_license_section"
                        android:textColor="@color/github_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.Sunset.REN.GitHub.ui.components.SunsetChipButton
                        android:id="@+id/text_repository_create_license_picker"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_repository_create_input"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/github_black"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="13dp"
                android:background="@color/github_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/repository_create_features_section"
                android:textColor="@color/github_black"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/check_repository_create_issues"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_repository_create_feature_chip"
                    android:buttonTint="@color/repository_create_control_tint"
                    android:checked="true"
                    android:padding="7dp"
                    android:text="@string/repository_create_feature_issues"
                    android:textColor="@color/github_black"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/check_repository_create_projects"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_repository_create_feature_chip"
                    android:buttonTint="@color/repository_create_control_tint"
                    android:checked="true"
                    android:padding="7dp"
                    android:text="@string/repository_create_feature_projects"
                    android:textColor="@color/github_black"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/check_repository_create_wiki"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_repository_create_feature_chip"
                    android:buttonTint="@color/repository_create_control_tint"
                    android:checked="true"
                    android:padding="7dp"
                    android:text="@string/repository_create_feature_wiki"
                    android:textColor="@color/github_black"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/repository_create_feature_desc"
                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_repository_create_submit"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/github_black"
            android:elevation="4dp"
            android:text="@string/repository_create_submit"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="14dp" />
    </LinearLayout>
</ScrollView>