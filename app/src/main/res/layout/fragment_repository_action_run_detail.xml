<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_repository_action_run_detail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_canvas"
    android:fillViewport="true"
    tools:context=".ui.repo.RepositoryActionRunDetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_horizontal_padding"
        android:paddingVertical="@dimen/page_vertical_padding">

        <TextView
            android:id="@+id/text_repository_action_run_detail_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
            android:visibility="gone"
            tools:text="正在加载 Actions 运行详情……"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_repository_action_run_detail_retry"
            style="@style/Widget.SunsetGitHub.Material.GlobalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/repository_action_run_detail_retry"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_repository_action_run_detail_open_actions"
            style="@style/Widget.SunsetGitHub.Material.GlobalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/repository_action_run_detail_open_in_github"
            android:textAllCaps="false"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/container_repository_action_run_detail_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_repository_action_run_detail_status_badge"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_repository_action_run_badge"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                    android:textColor="@color/github_success"
                    android:textStyle="bold"
                    tools:text="OK" />

                <TextView
                    android:id="@+id/text_repository_action_run_detail_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Title"
                    tools:text="6.1.141 欧加真OKI内核快速构建 #11" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_repository_action_run_detail_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                tools:text="Manually triggered 15 hours ago" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SunsetGitHub.Material.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/text_repository_action_run_detail_summary_label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/repository_action_run_detail_manually_triggered"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" />

                            <TextView
                                android:id="@+id/text_repository_action_run_detail_summary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                                android:textColor="@color/github_text_primary"
                                tools:text="SunsetRNE · 172e916 · main" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/repository_action_run_detail_status_label"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" />

                            <TextView
                                android:id="@+id/text_repository_action_run_detail_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                                android:textColor="@color/github_text_primary"
                                tools:text="Success" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/repository_action_run_detail_total_duration"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" />

                            <TextView
                                android:id="@+id/text_repository_action_run_detail_duration"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                                android:textColor="@color/github_text_primary"
                                tools:text="6m 32s" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/repository_action_run_detail_artifacts_count"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" />

                            <TextView
                                android:id="@+id/text_repository_action_run_detail_artifacts_count"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                                android:textColor="@color/github_text_primary"
                                tools:text="1" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_repository_action_run_detail_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                        tools:text="Started: 2026-07-02 11:20:16" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SunsetGitHub.Material.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/text_repository_action_run_detail_workflow_file"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                        android:textColor="@color/github_text_primary"
                        android:textStyle="bold"
                        tools:text="fastbuild_6.1.141.yml" />

                    <TextView
                        android:id="@+id/text_repository_action_run_detail_workflow_event"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                        tools:text="on: workflow_dispatch" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_repository_action_run_detail_build_job"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_repository_action_run_badge"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/repository_action_run_detail_job_build"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                            android:textColor="@color/github_text_primary" />

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="-"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" />

                        <TextView
                            android:id="@+id/text_repository_action_run_detail_release_job"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_repository_action_run_badge"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/repository_action_run_detail_job_release"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                            android:textColor="@color/github_text_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SunsetGitHub.Material.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_repository_action_run_detail_logs_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/repository_action_run_detail_logs_title"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                            android:textColor="@color/github_text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_repository_action_run_detail_logs_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                            tools:text="3 files" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_repository_action_run_detail_refresh_logs"
                            style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:text="@string/repository_action_run_detail_logs_refresh"
                            android:textAllCaps="false" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_repository_action_run_detail_download_logs"
                            style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:minWidth="0dp"
                            android:text="@string/repository_action_run_detail_logs_download"
                            android:textAllCaps="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_repository_action_run_detail_logs_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                        android:visibility="gone"
                        tools:text="正在读取编译日志……"
                        tools:visibility="visible" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fillViewport="true"
                        android:scrollbars="horizontal">

                        <TextView
                            android:id="@+id/text_repository_action_run_detail_logs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@color/github_subtle_background"
                            android:fontFamily="monospace"
                            android:minWidth="320dp"
                            android:padding="12dp"
                            android:textColor="@color/github_text_primary"
                            android:textIsSelectable="true"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:text="== build.txt ==\nRun ./gradlew assembleDebug\nBUILD SUCCESSFUL"
                            tools:visibility="visible" />
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SunsetGitHub.Material.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/text_repository_action_run_detail_assets_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/repository_action_run_detail_assets_title"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                        android:textColor="@color/github_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_repository_action_run_detail_assets_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                        android:visibility="gone"
                        tools:text="正在加载构建产物……"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/container_repository_action_run_detail_assets_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/repository_action_run_detail_artifact_name"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" />

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="@string/repository_action_run_detail_artifact_size"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/container_repository_action_run_detail_assets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:divider="@drawable/divider_repository_contents"
                        android:orientation="vertical"
                        android:showDividers="middle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
