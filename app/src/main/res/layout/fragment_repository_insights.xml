<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_canvas"
    tools:context=".ui.repo.RepositoryInsightsFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:id="@+id/card_repository_insights_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_repository_insights_hero"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progress_repository_insights_state"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/text_repository_insights_state_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Title"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/text_repository_insights_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                    android:textColor="#DDFFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_repository_insights_retry"
                    style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/repository_insights_retry"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_repository_insights_skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_repository_insights_hero"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:alpha="0.45"
                            android:background="@drawable/bg_repository_insights_hero_chip" />

                        <View
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="10dp"
                            android:alpha="0.55"
                            android:background="@drawable/bg_repository_insights_hero_icon" />
                    </LinearLayout>

                    <View
                        android:layout_width="240dp"
                        android:layout_height="38dp"
                        android:layout_marginTop="18dp"
                        android:alpha="0.48"
                        android:background="@drawable/bg_repository_insights_hero_chip" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:layout_marginTop="14dp"
                        android:alpha="0.42"
                        android:background="@drawable/bg_repository_insights_hero_chip" />

                    <View
                        android:layout_width="220dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="8dp"
                        android:alpha="0.36"
                        android:background="@drawable/bg_repository_insights_hero_chip" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="70dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:alpha="0.7"
                            android:background="@drawable/bg_repository_insights_hero_stat" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="70dp"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:alpha="0.7"
                            android:background="@drawable/bg_repository_insights_hero_stat" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="70dp"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:alpha="0.7"
                            android:background="@drawable/bg_repository_insights_hero_stat" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="82dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_repository_insights_status_info"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <View
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_skeleton_circle" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="150dp"
                                android:layout_height="16dp"
                                android:background="@drawable/bg_skeleton_block" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="14dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_skeleton_block" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_repository_insights_chip_selected" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_repository_section_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <View
                        android:layout_width="170dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_skeleton_block" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_skeleton_block" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_chip" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_chip" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_chip" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_repository_section_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <View
                        android:layout_width="150dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_skeleton_block" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="82dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="82dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="82dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="82dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_repository_insights_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/card_repository_insights_hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_repository_insights_hero"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_repository_insights_status_chip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_repository_insights_hero_chip"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            tools:text="● Live synthesis" />

                        <TextView
                            android:id="@+id/text_repository_insights_hero_icon"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_repository_insights_hero_icon"
                            android:gravity="center"
                            android:text="@string/repository_insights_hero_icon"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_repository_insights_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="@color/white"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        tools:text="Insights cockpit" />

                    <TextView
                        android:id="@+id/text_repository_insights_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#DDFFFFFF"
                        android:textSize="14sp"
                        tools:text="原生高级驾驶舱：仓库活跃度、质量与维护状态聚合视图。" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_repository_insights_hero_stat"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:id="@+id/text_repository_insights_health"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="Good" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/repository_insights_hero_health"
                                android:textColor="#BFFFFFFF"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_repository_insights_hero_stat"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:id="@+id/text_repository_insights_freshness"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="Now" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/repository_insights_hero_freshness"
                                android:textColor="#BFFFFFFF"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_repository_insights_hero_stat"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:id="@+id/text_repository_insights_coverage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="8/10" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/repository_insights_hero_coverage"
                                android:textColor="#BFFFFFFF"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/container_repository_insights_status_strip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/text_repository_insights_status_strip_icon"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:textColor="@color/github_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="✓" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/text_repository_insights_status_strip_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                                android:textColor="@color/github_text_primary"
                                android:textStyle="bold"
                                tools:text="实时洞察已同步" />

                            <TextView
                                android:id="@+id/text_repository_insights_status_strip_description"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                                android:textColor="@color/github_text_secondary"
                                tools:text="仓库活跃度、质量信号和访问数据已聚合为当前驾驶舱视图。" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_repository_insights_tab_overview"
                        style="@style/Widget.SunsetGitHub.Material.Button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:singleLine="true"
                        android:text="@string/repository_insights_section_overview"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_repository_insights_tab_pulse"
                        style="@style/Widget.SunsetGitHub.Material.Button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:singleLine="true"
                        android:text="@string/repository_insights_section_activity"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_repository_insights_tab_quality"
                        style="@style/Widget.SunsetGitHub.Material.Button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:singleLine="true"
                        android:text="@string/repository_insights_section_quality"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_repository_insights_tab_traffic"
                        style="@style/Widget.SunsetGitHub.Material.Button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:singleLine="true"
                        android:text="@string/repository_insights_section_traffic"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/container_repository_insights_overview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/container_repository_insights_activity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_repository_section_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/text_repository_insights_chart_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/repository_insights_chart_title"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Title"
                            android:textColor="@color/github_text_primary" />

                        <TextView
                            android:id="@+id/text_repository_insights_chart_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                            android:textColor="@color/github_text_muted" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/button_repository_insights_chart_combined"
                                    style="@style/Widget.SunsetGitHub.Material.Button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/repository_insights_chart_combined" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/button_repository_insights_chart_actions"
                                    style="@style/Widget.SunsetGitHub.Material.Button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/repository_insights_chart_actions" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/button_repository_insights_chart_issues"
                                    style="@style/Widget.SunsetGitHub.Material.Button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/repository_insights_chart_issues" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/button_repository_insights_chart_releases"
                                    style="@style/Widget.SunsetGitHub.Material.Button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/repository_insights_chart_releases" />
                            </LinearLayout>
                        </HorizontalScrollView>

                        <com.Sunset.REN.GitHub.ui.repo.RepositoryInsightsBarChartView
                            android:id="@+id/chart_repository_insights_bars"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/repository_insights_chart_height"
                            android:layout_marginTop="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/text_repository_insights_chart_hint"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                                android:textColor="@color/github_text_muted" />

                            <TextView
                                android:id="@+id/text_repository_insights_chart_total"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                                android:textColor="@color/github_text_primary"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/container_repository_insights_feed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_repository_section_card"
                        android:orientation="vertical"
                        android:padding="16dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/container_repository_insights_quality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_repository_section_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/container_repository_insights_notices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_repository_section_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/container_repository_insights_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_repository_section_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/text_repository_insights_actions_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/repository_insights_fallback_title"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                        android:textColor="@color/github_text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/repository_insights_fallback_description"
                        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
                        android:textColor="@color/github_text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_repository_insights_open_in_github"
                        style="@style/Widget.SunsetGitHub.Material.GlobalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/repository_section_open_in_github" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
