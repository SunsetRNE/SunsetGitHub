<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_canvas"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="32dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/token_login_choice_title" android:textColor="@color/github_text_primary" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="@string/token_login_choice_subtitle" android:textColor="@color/github_text_secondary" android:textSize="15sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:background="@drawable/bg_auth_method_card" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/token_login_have_title" android:textColor="@color/github_text_primary" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/token_login_have_desc" android:textColor="@color/github_text_secondary" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_have_token" style="@style/Widget.SunsetGitHub.Material.PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/token_login_have_title" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_auth_method_card" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/token_login_need_title" android:textColor="@color/github_text_primary" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/token_login_need_desc" android:textColor="@color/github_text_secondary" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/button_need_token_guide" style="@style/Widget.SunsetGitHub.Material.GlobalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/token_login_guide_action" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="@string/token_login_security_note" android:textColor="@color/github_text_muted" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>