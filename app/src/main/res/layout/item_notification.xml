<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_row"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="78dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <View
        android:id="@+id/view_notification_unread_indicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/bg_notification_unread_indicator" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_notification_repository"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
            android:textColor="@color/github_text_muted"
            android:textSize="12sp"
            tools:text="owner/repo" />

        <TextView
            android:id="@+id/text_notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
            android:textColor="@color/github_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Issue or pull request title" />

        <TextView
            android:id="@+id/text_notification_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Meta"
            android:textColor="@color/github_text_secondary"
            android:textSize="12sp"
            tools:text="mention · 2025-01-02T12:34:56Z" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_notification_type"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_notification_type_badge"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxWidth="92dp"
        android:maxLines="1"
        android:minWidth="48dp"
        android:paddingHorizontal="8dp"
        android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Pill"
        android:textColor="@color/github_text_secondary"
        android:textSize="11sp"
        tools:text="Issue" />
</LinearLayout>