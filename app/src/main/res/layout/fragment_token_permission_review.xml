<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_canvas"
    android:fillViewport="true"
    tools:context=".ui.auth.TokenPermissionReviewFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/auth_token_review_page_title"
            android:textColor="@color/github_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/auth_token_review_page_subtitle"
            android:textColor="@color/github_text_secondary"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/edit_review_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_auth_method_card"
            android:gravity="top"
            android:hint="@string/auth_token_input_hint"
            android:inputType="textVisiblePassword"
            android:minLines="4"
            android:padding="14dp"
            android:textIsSelectable="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_recheck_token"
            style="@style/Widget.SunsetGitHub.Material.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/auth_token_review_recheck_action" />

        <TextView
            android:id="@+id/text_token_review_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/github_text_muted"
            android:textSize="13sp"
            tools:text="正在检测 token……" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_auth_method_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_token_review_account_title"
                android:textColor="@color/github_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_token_review_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/github_text_primary"
                android:textSize="15sp"
                tools:text="octocat" />

            <TextView
                android:id="@+id/text_token_review_scopes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/github_text_secondary"
                android:textSize="12sp"
                tools:text="repo, workflow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/container_token_permission_checks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/text_token_review_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/github_danger"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Token 无效"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_confirm_token_login"
            style="@style/Widget.SunsetGitHub.Material.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/auth_token_review_confirm_home" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel_token_login"
            style="@style/Widget.SunsetGitHub.Material.GlobalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auth_token_review_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_regenerate_token"
            style="@style/Widget.SunsetGitHub.Material.GlobalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auth_token_review_open_token_page" />
    </LinearLayout>
</ScrollView>