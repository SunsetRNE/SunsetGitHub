<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/github_canvas"
    tools:context=".ui.repo.RepositoryIssuesFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="0dp">

        <TextView
            android:id="@+id/text_repository_issues_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="搜索或筛选问题" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/github_surface"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <HorizontalScrollView
                android:id="@+id/scroll_repository_issues_primary_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/container_repository_issues_primary_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp" />
            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/scroll_repository_issues_labels_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:overScrollMode="never"
                android:paddingHorizontal="16dp"
                android:scrollbars="none"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/container_repository_issues_labels_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp" />
            </HorizontalScrollView>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_repository_issues_retry"
            style="@style/Widget.SunsetGitHub.Material.GlobalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/repository_issues_retry"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/container_repository_issues_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_repository_empty_state_panel"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/text_repository_issues_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/repository_issues_empty"
                android:textAppearance="@style/TextAppearance.SunsetGitHub.Material.Body"
                android:textColor="@color/github_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/container_repository_issues_skeleton"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/github_surface"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <include layout="@layout/view_repository_issue_skeleton_row" />
            <include layout="@layout/view_repository_issue_skeleton_row" />
            <include layout="@layout/view_repository_issue_skeleton_row" />
            <include layout="@layout/view_repository_issue_skeleton_row" />
            <include layout="@layout/view_repository_issue_skeleton_row" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_repository_issues_items"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/github_surface"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingBottom="@dimen/page_vertical_padding"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="8"
            tools:listitem="@android:layout/simple_list_item_1"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_repository_issues_load_more"
            style="@style/Widget.SunsetGitHub.Material.GlobalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:text="@string/repository_issues_load_more"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_repository_issues_create"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:background="@drawable/bg_github_fab_round"
        android:contentDescription="@string/repository_issues_create_title"
        android:src="@drawable/ic_add_24"
        android:visibility="gone"
        app:backgroundTint="@color/github_success"
        app:tint="@color/white"
        tools:visibility="visible" />
</FrameLayout>