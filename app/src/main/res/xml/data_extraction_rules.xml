<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
        Backup is intentionally disabled in AndroidManifest.xml because this app may
        cache repository contents, workspace files, OAuth state, and other account data.
        Keep these rules explicit so future manifest changes do not silently enable
        cloud backup or device-to-device transfer for app-private data.
    -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
