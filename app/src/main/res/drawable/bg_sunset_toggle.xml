<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <size android:width="44dp" android:height="32dp" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:top="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="13dp" />
                    <solid android:color="@color/github_accent_soft_border" />
                </shape>
            </item>
            <item android:width="22dp" android:height="22dp" android:gravity="end|center_vertical" android:right="5dp">
                <shape android:shape="oval">
                    <solid android:color="@color/white" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_enabled="false">
