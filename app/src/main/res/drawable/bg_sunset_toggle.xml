                    <solid android:color="#FF9EA3A8" />
                </shape>
            </item>
            <item android:width="22dp" android:height="22dp" android:gravity="start|center_vertical" android:left="5dp">
                <shape android:shape="oval">
                    <solid android:color="#FFEEEEEE" />
                </shape>
            </item>
        </layer-list>
    </item>
