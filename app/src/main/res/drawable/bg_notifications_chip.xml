<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/github_notification_chip_selected" />
            <stroke
                android:width="1dp"
                android:color="@color/github_notification_chip_selected_border" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/github_notification_chip_background" />
            <stroke
                android:width="1dp"
                android:color="@color/github_border" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
